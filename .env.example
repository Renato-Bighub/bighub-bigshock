# Copiar para .env (nunca commitar segredos reais)
DATABASE_URL=postgres://bigstock:bigstock@localhost:5432/bigstock
REDIS_URL=redis://localhost:6379
API_PORT=3001
LOG_LEVEL=info
API_URL=http://localhost:3001
DOWNLOAD_URL_SECRET=troque-por-um-segredo-longo-e-aleatorio
STORAGE_DIR=.storage

# Armazenamento S3/R2 (obrigatório na Vercel; sem S3_BUCKET usa disco local)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Ligações de BD por instância (serverless: 1-3; use o URL "pooled" do fornecedor)
DB_POOL_MAX=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
WEB_URL=http://localhost:3000

# IA (Fase 4). Em dev: AI_PROVIDER=fake (por omissão). Em produção: openai + chave.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Fila (BullMQ). A API enfileira; o worker (apps/worker) consome.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
CRON_SECRET=

# E-mail transacional (Resend)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=BIGstock <no-reply@example.com>
