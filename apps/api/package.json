{
  "name": "@bigstock/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:catalog": "node dist/seed-catalog.js",
    "seed:folder": "node --env-file-if-exists=../../.env dist/seed-folder.js",
    "build:vercel": "tsc -p tsconfig.build.json && node scripts-bundle.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@bigstock/billing": "workspace:*",
    "@bigstock/contracts": "workspace:*",
    "@bigstock/database": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^11.16.0",
    "bullmq": "^6.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  },
  "type": "module",
  "exports": {
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "default": "./dist/worker-entry.js"
    }
  }
}
