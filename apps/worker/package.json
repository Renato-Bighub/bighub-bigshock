{
  "name": "@bigstock/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & STORAGE_DIR=${STORAGE_DIR:-../api/.storage} node --watch dist/main.js",
    "start": "STORAGE_DIR=${STORAGE_DIR:-../api/.storage} node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bigstock/api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
