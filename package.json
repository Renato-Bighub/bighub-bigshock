{
  "name": "bighub-bigstock",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev:infra": "docker compose up -d",
    "dev:api": "pnpm --filter @bigstock/api dev",
    "dev:worker": "pnpm --filter @bigstock/worker dev",
    "dev:web": "pnpm --filter @bigstock/web dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
